# =====================================================
# Business Backend 环境配置示例
# 使用方法：cp .env.example .env 后按需修改
# =====================================================

# ---------- 应用 ----------
APP_NAME=Business Backend
APP_ENV=development            # development | testing | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_PREFIX=/api/v1
APP_TIMEZONE=Asia/Shanghai
APP_ADMIN_PASSWORD=Admin@123456     # 初始超管账号(admin)密码，生产务必修改

# ---------- 数据库 (MySQL 8) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=business_backend
DB_ECHO=false                  # 打印 SQL 日志，便于调试
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- JWT / 安全（生产环境务必更换） ----------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- 文件存储 ----------
FILE_STORAGE_DIR=storage              # 本地存储根目录（相对项目根）
FILE_MAX_SIZE=10485760               # 单文件大小上限（字节），默认 10MB
FILE_ALLOWED_EXTENSIONS=["pdf","doc","docx","xls","xlsx","ppt","pptx","txt","md","csv","png","jpg","jpeg","gif","webp","svg","mp3","mp4","zip"]
FILE_PUBLIC_BASE_URL=                # 可选：对外访问基础 URL（CDN/网关前缀），留空返回相对路径

# ---------- AI 能力（内嵌模块 app/modules/ai/）----------
# 真实模型 API Key 由模型供应商（sys_model_provider.api_key）配置，此处仅放非敏感配置
# Agent 未绑定模型实例时的兜底模型；留空则要求 Agent 必须绑定
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT=180               # 单次 LLM 调用超时（秒）；推理模型「先想后答」，建议 180~300
AI_MAX_RETRIES=2                     # 失败重试次数
AI_MAX_HISTORY_ROUNDS=10             # 对话最大历史轮数（保留最近 N 轮）
AI_STREAM_USAGE=true                 # 流式对话是否请求 token 用量（网关不支持时置 false）

# ---------- 联网搜索（web_search 工具）----------
# 搜索服务 API Key（Tavily / 百炼 / 博查等，勿硬编码）
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5             # 单次搜索返回结果条数

# ---------- 向量检索 (Qdrant) ----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false                   # 远程 Qdrant Cloud 需 true
# Qdrant Cloud / 自建鉴权时使用，本地可留空
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# ---------- 文档切分（RAG 索引）----------
CHUNK_SIZE=800                       # 切分块大小（字符）
CHUNK_OVERLAP=120                    # 切分块重叠（字符）
EMBEDDING_BATCH_SIZE=16              # embedding 单批条数（兼容接口对单次 input 数组有上限，过大 400/413）
INDEX_STALE_MINUTES=15               # parsing 超过该分钟数视为僵尸任务，允许重试恢复

# ---------- RAG 检索 ----------
RAG_TOP_K=4                          # 每次检索返回的 top-k 块数
RAG_SCORE_THRESHOLD=0.3              # 相似度阈值（0~1，越大越严格；文本 embedding 普遍偏低，勿设 0.7）

# ---------- 用量统计 ----------
USAGE_TIMEZONE=Asia/Shanghai         # 用量"自然日"切分时区（仅用量统计读取，与容器 TZ 无关）

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 日志栈 (Loki / Promtail / Grafana) ----------
GRAFANA_ADMIN_PASSWORD=admin          # Grafana 首次登录密码，生产务必修改
