# =====================================================
# Business Backend 环境配置示例
# 使用方法：cp .env.example .env 后按需修改
# =====================================================

# ---------- 应用 ----------
APP_NAME=Business Backend
APP_ENV=development            # development | testing | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_PREFIX=/api/v1
APP_TIMEZONE=Asia/Shanghai

# ---------- 数据库 (MySQL 8) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=business_backend
DB_ECHO=false                  # 打印 SQL 日志，便于调试
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- JWT / 安全（生产环境务必更换） ----------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- 日志 ----------
LOG_LEVEL=INFO
