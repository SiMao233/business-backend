# =====================================================
# Business Backend 环境配置示例
# 使用方法：cp .env.example .env 后按需修改
# =====================================================

# ---------- 应用 ----------
APP_NAME=Business Backend
APP_ENV=development            # development | testing | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_PREFIX=/api/v1
APP_TIMEZONE=Asia/Shanghai
APP_ADMIN_PASSWORD=Admin@123456     # 初始超管账号(admin)密码，生产务必修改

# ---------- 数据库 (MySQL 8) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=business_backend
DB_ECHO=false                  # 打印 SQL 日志，便于调试
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- JWT / 安全（生产环境务必更换） ----------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------- 文件存储 ----------
FILE_STORAGE_DIR=storage              # 本地存储根目录（相对项目根）
FILE_MAX_SIZE=10485760               # 单文件大小上限（字节），默认 10MB
FILE_ALLOWED_EXTENSIONS=["pdf","doc","docx","xls","xlsx","ppt","pptx","txt","md","csv","png","jpg","jpeg","gif","webp","svg","mp3","mp4","zip"]
FILE_PUBLIC_BASE_URL=                # 可选：对外访问基础 URL（CDN/网关前缀），留空返回相对路径

# ---------- AI 能力（内嵌模块 app/modules/ai/）----------
# 真实模型 API Key 由模型供应商（sys_model_provider.api_key）配置，此处仅放非敏感配置
# Agent 未绑定模型实例时的兜底模型；留空则要求 Agent 必须绑定
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT=180               # 单次 LLM 调用超时（秒）；推理模型「先想后答」，建议 180~300
AI_MAX_RETRIES=2                     # 失败重试次数
AI_MAX_HISTORY_ROUNDS=10             # 对话最大历史轮数（保留最近 N 轮）
AI_STREAM_USAGE=true                 # 流式对话是否请求 token 用量（网关不支持时置 false）

# ---------- 联网搜索（web_search 工具）----------
# 搜索服务 API Key（Tavily / 百炼 / 博查等，勿硬编码）
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5             # 单次搜索返回结果条数

# ---------- 向量检索 (Qdrant) ----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_HTTPS=false                   # 远程 Qdrant Cloud 需 true
# Qdrant Cloud / 自建鉴权时使用，本地可留空
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# ---------- 文档切分（RAG 索引）----------
CHUNK_SIZE=800                       # 切分块大小（字符）
CHUNK_OVERLAP=120                    # 切分块重叠（字符）
EMBEDDING_BATCH_SIZE=16              # embedding 单批条数（兼容接口对单次 input 数组有上限，过大 400/413）
INDEX_STALE_MINUTES=15               # parsing 超过该分钟数视为僵尸任务，允许重试恢复

# ---------- RAG 检索 ----------
RAG_TOP_K=4                          # 每次检索返回的 top-k 块数
RAG_SCORE_THRESHOLD=0.3              # 相似度阈值（0~1，越大越严格；文本 embedding 普遍偏低，勿设 0.7）

# ---------- Hybrid 检索（向量 + 关键词 + RRF 融合）----------
RAG_HYBRID_ENABLED=true              # 置 false 回退纯向量检索（对比排查 / 故障降级）
RAG_KEYWORD_TOP_K=8                  # 关键词路召回条数
RAG_KEYWORD_MAX_TERMS=8              # 单次查询抽取的关键词上限
RAG_VECTOR_FETCH_K=12                # 向量路过取条数（融合前取更多候选）
RAG_RRF_K=60                         # RRF 常数 k（原论文取 60）
RAG_VECTOR_WEIGHT=1.0                # RRF 向量路权重
RAG_KEYWORD_WEIGHT=1.0               # RRF 关键词路权重

# ---------- Reranker 精排（Hybrid 负责召回 → Reranker 负责精排）----------
# 候选池：召回宁多勿漏，交给 Reranker 收窄到 RAG_TOP_K（仅启用时生效）
RAG_CANDIDATE_K=30                   # 融合候选池条数
RAG_RERANK_ENABLED=false             # 总开关；关闭时走 NoopReranker，零外部调用
# ⚠️ rerank 的 base_url 与 embedding 不同（百炼为 compatible-api/v1），需单独建供应商：
#    供应商 base_url=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1
#    模型实例 code=qwen3-rerank，model_type=rerank
RERANK_PROVIDER_CODE=                # rerank 供应商 code（如 qwen-rerank）
RERANK_MODEL_CODE=                   # rerank 实例 code（如 qwen3-rerank）；空=降级
RAG_RERANK_SCORE_THRESHOLD=0.0       # 相关性阈值；0=不过滤（先观察分数分布再调）
RAG_RERANK_TIMEOUT=5.0               # 单次 rerank 超时（秒）；Reranker 串行阻塞首 token，必须快速降级
RAG_RERANK_INSTRUCT=                 # 可选英文指令；空=模型默认「问答检索」策略

# ---------- Query Rewrite 查询改写（多轮指代 / 省略补全，只改善检索）----------
RAG_QUERY_REWRITE_ENABLED=false      # 总开关；关闭时零外部调用，行为与改造前一致
RAG_QUERY_REWRITE_HISTORY_ROUNDS=2   # 参与改写的历史轮数（用户 + 助手 = 1 轮）
RAG_QUERY_REWRITE_TIMEOUT=6.0        # 改写超时（秒）；实测耗时 1.2~4.4s，过紧会偶发误杀
# ⚠️ 推理模型的 reasoning token 与正文共用该预算：128 会被 reasoning 吃光导致正文为空
#    （finish_reason=length）→ 每次都被判非法、恒降级回原问题；推理模型请设 1024
RAG_QUERY_REWRITE_MAX_TOKENS=128     # 改写输出 token 上限
RAG_QUERY_REWRITE_MAX_CHARS=200      # 改写结果字符上限，超出即回退原问题

# ---------- RAG Grounding 证据接地（严格提示词 + 引用审计 + 证据不足拒答）----------
RAG_GROUNDING_ENABLED=true           # 总开关：注入严格接地规则 + 引用审计；置 false 行为同改造前（零回归）
RAG_ABSTAIN_ENABLED=true             # 证据不足时后端直接拒答（固定文案，不调用模型，usage 记 0）
# 阈值只对「最高 rerank 分」生效（命中为空时无条件拒答，不看阈值）。
# 依据：实测 qwen3-rerank 对相关片段打分约 0.48~0.89，故取低于下沿的 0.35 作初始校准值；
# 上线后按日志校准：正常问答被误拒 → 调低；无关问题仍作答 → 调高。
# ⚠️ 向量余弦（相关片段仅 0.25~0.6）不参与阈值判断 → 未启用 Reranker 时一律 fail-open，
#    此时只有「检索 0 命中」会拒答（要完整生效请同时开 RAG_RERANK_ENABLED）。
RAG_ABSTAIN_MIN_SCORE=0.35
# 拒答文案（前端直接展示，与提示词里的拒答要求保持一致）
RAG_ABSTAIN_MESSAGE=根据当前知识库，我无法确认这个问题。

# ---------- 用量统计 ----------
USAGE_TIMEZONE=Asia/Shanghai         # 用量"自然日"切分时区（仅用量统计读取，与容器 TZ 无关）

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 日志栈 (Loki / Promtail / Grafana) ----------
GRAFANA_ADMIN_PASSWORD=admin          # Grafana 首次登录密码，生产务必修改
